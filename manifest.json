    { "name": "Contact (vCard) QR code", "short_name": "Contact", "url": "/?type=vcard&source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bulk QR codes from CSV", "short_name": "Bulk", "url": "/?type=bulk&source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
